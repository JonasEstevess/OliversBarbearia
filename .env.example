# Porta do servidor local
PORT=3000

# Conta de administrador criada na primeira execução (troque antes de publicar)
ADMIN_EMAIL=admin@oliversbarbearia.local
ADMIN_PASSWORD=troque-esta-senha

# Banco de dados em produção (Turso). Deixe vazio para usar o arquivo local data/olivers.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Em produção use "production" (cookies só via HTTPS). A Vercel já define isso.
NODE_ENV=development

# E-mail (recuperação de senha). Sem domínio próprio, use um Gmail da barbearia
# com verificação em 2 etapas ativa + "Senha de app" (myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASS=
# Opcionais (padrão: Gmail, porta 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM=

# Conta(s) que viram dona(s) automaticamente (a pessoa usa a própria senha).
# Separe vários e-mails por vírgula. Só promove contas cadastradas.
OWNER_EMAIL=
